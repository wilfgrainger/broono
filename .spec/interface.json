      "water_goal": "number"
    },
    "magic_links": {
      "id": "string",
      "email": "string",
      "token_hash": "string",
      "expires_at": "number",
      "used": "number"
    }
  },
  "localStorage": {
    "broono-store": {
      "state": {
        "authToken": "string?",
        "hasCompletedOnboarding": "boolean",
        "profile": "object",
        "logs": "array",
        "journal": "array",
        "dailyWater": "object"
      }
    }
  }
