{
  "api": {
    "baseUrl": "/api",
    "endpoints": {
      "GET /": {
        "response": {
          "status": "string",
          "message": "string"
        }
      },
      "POST /api/auth/send-magic-link": {
        "request": {
          "email": "string"
        },
        "response": {
          "success": "boolean"
        }
      },
      "GET /api/auth/verify": {
        "query": {
          "token": "string"
        },
        "response": {
          "token": "string",
          "user": {
            "id": "string",
            "email": "string"
          }
        }
      },
      "POST /api/stripe/create-checkout-session": {
        "request": {
          "priceId": "string"
        },
        "response": {
          "url": "string"
        }
      },
      "POST /api/stripe/webhook": {
        "request": "Stripe Event Signature",
        "response": {
          "received": "boolean"
        }
      },
      "DELETE /api/user": {
        "headers": {
          "Authorization": "Bearer <token>"
        },
        "response": {
          "success": "boolean"
        }
      }
    }
  },
  "database": {
    "users": {
      "id": "string",
      "email": "string",
      "created_at": "number",
      "stripe_customer_id": "string?",
