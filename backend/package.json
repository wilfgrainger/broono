{
  "name": "broono-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute broono-db --file=./schema.sql --local",
    "db:deploy": "wrangler d1 execute broono-db --file=./schema.sql --remote",
    "test": "tsc -p tsconfig.tests.json && node --test dist-test/tests/play-rtdn.test.js dist-test/tests/auth-flow.test.js dist-test/tests/waitlist-hardening.test.js"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.2",
    "wrangler": "^4.70.0"
  }
}
