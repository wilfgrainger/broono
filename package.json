{
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "deploy:worker": "wrangler deploy --env=\"\"",
    "deploy:worker:dry-run": "wrangler deploy --dry-run --env=\"\"",
    "deploy:web": "npm run build && wrangler pages deploy dist --project-name broono --commit-dirty=true",
    "deploy": "npm run deploy:worker && npm run deploy:web"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "typescript": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.4.1",
    "@playwright/test": "^1.61.1",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "jsdom": "latest",
    "vitest": "latest",
    "wrangler": "^4.114.0"
  }
}
